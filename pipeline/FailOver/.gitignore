# Local operational originals, notes, inventories, and captured output.
/local/

# Real inventories are provisioned separately; only sanitized examples are shared.
/inventory/**/*.ini

# Local credentials and environment files.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
/credentials/
/secrets/

# Files generated by Jenkins/Ansible.
/temp_vars.yml
/start_ogg_services.yml
*.retry

# Runtime logs and process state.
*.log
*.pid

# Python/tool caches and virtual environments.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.class

# Editor, OS, and local assistant settings.
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
