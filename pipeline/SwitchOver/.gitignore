# Private inventory, unmodified originals, prompts and captured operational output.
/local/

# Real inventories stay private; only sanitized examples are publishable.
*.ini
!/config/examples/*.ini
.env
.env.*
!.env.example
*.key
*.pem
id_rsa*
id_ed25519*

# Runtime logs, AdminClient captures, locks and temporary files.
*.log
*.out
*.tmp
*.pid
*.lock
*.lock/
/log/
/logs/
/tmp/

# Files generated by Jenkins, never maintained Ansible sources.
ogg_operational_actions.yml
ogg_operational_vars.yml

# Exported reports and local editor/OS state.
*.docx
~$*
.DS_Store
Thumbs.db
*.swp
*.swo
__pycache__/
*.py[cod]
